# ---------- 1. Required ----------
PORT=3710
# A long random password. Sarvam sends it with every tool call. Make one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JARVIS_TOKEN=
# YOUR mobile number, digits only, with country code. Example: 919876543210
# Calls from any other number are refused.
OWNER_NUMBER=
# true while you test with the Sarvam "Test agent" button. Set to false once phone calls work.
ALLOW_NO_CALLER=true
# Your Sarvam phone number, only shown on the dashboard. Example: +91 98765 43210
JARVIS_PHONE=

# ---------- 2. Optional: J calls YOU (deadline + battery reminders) ----------
# Leave these empty and everything else still works.
SARVAM_WORKSPACE_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
ARRC_APP_ID=
ARRC_APP_VERSION=
ARRC_AGENT_NUMBER=
ARRC_CONNECTION_ID=

# ---------- 3. Optional: Google Classroom uploads ----------
# Empty = off. attach = upload the file but do NOT turn it in (recommended). live = upload AND turn in.
CLASSROOM_SUBMIT=
